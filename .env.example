# ── Pixelmonks Portfolio — environment variables ──────────────────────────────
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Suppress Django 6's "WARNING: This is a development server" message
DJANGO_RUNSERVER_HIDE_WARNING=true

# Optional — override the allowed host when testing behind a proxy or tunnel
# DJANGO_ALLOWED_HOST=yourapp.up.railway.app

# Resend API key — only needed when SiteSettings.contact_enable is True
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Set this to Railway's DATABASE_PUBLIC_URL to use `railway run` locally.
# Railway's container gets the private DATABASE_URL injected automatically.
# load_dotenv(override=True) ensures this local value wins over the private
# postgres.railway.internal URL that `railway run` would otherwise inject.
# If unset, Django falls back to SQLite for local development.
# DATABASE_URL=postgresql://postgres:password@monorail.proxy.rlwy.net:PORT/railway
