# ── Pixelmonks Portfolio — environment variables ──────────────────────────────
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Suppress Django 6's "WARNING: This is a development server" message
DJANGO_RUNSERVER_HIDE_WARNING=true

# Optional — override the allowed host when testing behind a proxy or tunnel
# DJANGO_ALLOWED_HOST=yourapp.up.railway.app

# Resend API key — only needed when SiteSettings.contact_enable is True
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional — set to a PostgreSQL DATABASE_URL to use Postgres locally.
# Railway injects this automatically for the deployed service.
# If unset, Django uses SQLite (db.sqlite3) in development.
# DATABASE_URL=postgresql://user:pass@localhost:5432/pixelmonks
